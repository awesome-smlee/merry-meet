# Supabase Settings > API. Never use NEXT_PUBLIC_ for the service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate long random secrets; all attendees use the same invite link.
MEETING_ID=replace-with-random-32-character-invite
# Public origin for link preview images (e.g. https://meet.example.com).
# Optional on Vercel: defaults to its production domain.
SITE_URL=
